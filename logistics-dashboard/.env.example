# 复制为 .env 并按本机实际情况填写（.env 不要提交到仓库）
# 领星 ERP 开放平台应用凭据
LX_APP_ID=
LX_APP_SECRET=

# WorkBuddy「发布为网站」页面的资料库地址（发货记录主表的来源）
WB_PAGE_URL=https://www.workbuddy.link/p/<你的页面ID>

# 共享盘发货记录.xlsx 的路径（主表唯一事实源）
SHARE_XLSX=\\<共享盘>\物流部\发货记录.xlsx

# 领星店铺 ID（sellerId）列表，逗号分隔；按自己账号在领星后台查
LX_SELLER_IDS=

# 钉钉 AI 表格同步（sync/dt_apply.py）
DINGTALK_TOOLS_DIR=
DINGTALK_NODE=
DINGTALK_MCP_CLI=
DINGTALK_ENV_FILE=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_OPERATOR_ID=
DINGTALK_BASE_ID=
DINGTALK_SHEET_ID=

# 站点与共享盘路径
WB_SITE_URL=
WB_SHARE_ROOT=
